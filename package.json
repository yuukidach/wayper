{
  "name": "wayper",
  "version": "2.0.1",
  "productName": "Wayper",
  "description": "Cross-platform wallpaper atelier and manager with Wallhaven integration",
  "license": "MIT",
  "main": "dist/main/index.cjs",
  "bin": {
    "wayper": "./bin/wayper.cjs",
    "wayper-gui": "./bin/wayper-gui.cjs"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:electron": "node scripts/test-electron.mjs",
    "test:watch": "vitest",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.4.2",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.1.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.25.4",
    "lucide-react": "^0.511.0",
    "motion": "^12.12.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "smol-toml": "^1.3.4",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3",
    "undici": "^7.30.2",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  },
  "build": {
    "appId": "com.wayper.app",
    "productName": "Wayper",
    "icon": "assets/icon.icns",
    "asar": true,
    "asarUnpack": [
      "dist/cli/**/*",
      "dist/worker/**/*",
      "node_modules/**/*"
    ],
    "files": [
      "dist/**/*",
      "bin/**/*",
      "package.json",
      "!**/node_modules/onnxruntime-web/**",
      "!**/node_modules/onnxruntime-node/bin/**",
      "**/node_modules/onnxruntime-node/bin/napi-v3/${platform}/${arch}/**",
      "!**/node_modules/onnxruntime-node/bin/**/libonnxruntime_providers_{cuda,tensorrt}.so",
      "!**/node_modules/@huggingface/transformers/{src,types}/**",
      "!**/node_modules/@huggingface/transformers/dist/*.{map,wasm}",
      "!**/node_modules/@huggingface/transformers/dist/transformers.{js,min.js,web.js,web.min.js}",
      "!**/node_modules/@huggingface/transformers/dist/ort-wasm*"
    ],
    "extraResources": [
      {
        "from": "assets/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "assets/icon-256.png",
        "to": "icon-256.png"
      },
      {
        "from": "assets/trayTemplate.png",
        "to": "trayTemplate.png"
      },
      {
        "from": "assets/trayTemplate@2x.png",
        "to": "trayTemplate@2x.png"
      }
    ],
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns",
      "category": "public.app-category.utilities"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": "nsis"
    },
    "linux": {
      "icon": "assets/icon-256.png",
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "directories": {
      "output": "release"
    }
  },
  "overrides": {
    "extract-zip": {
      "yauzl": "3.4.0"
    }
  },
  "allowScripts": {
    "electron": true,
    "electron-winstaller": true,
    "esbuild": true,
    "onnxruntime-node": true
  }
}
