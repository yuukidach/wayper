{
  "name": "wayper",
  "version": "1.8.12",
  "productName": "Wayper",
  "description": "Wayper Electron GUI",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:backend": "cd ../.. && uv run pyinstaller --clean wayper.spec",
    "dist": "npm run build:backend && ./node_modules/.bin/electron-builder",
    "test": "node --test tests/*.test.js"
  },
  "build": {
    "appId": "com.wayper.app",
    "icon": "../../assets/icon.icns",
    "extraResources": [
      {
        "from": "../../dist/wayper-backend",
        "to": "wayper-backend"
      },
      {
        "from": "../../assets/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "../../assets/icon-256.png",
        "to": "icon-256.png"
      },
      {
        "from": "../../assets/trayTemplate.png",
        "to": "trayTemplate.png"
      },
      {
        "from": "../../assets/trayTemplate@2x.png",
        "to": "trayTemplate@2x.png"
      }
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities"
    },
    "win": {
      "icon": "../../assets/icon.ico",
      "target": "nsis"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!tests/**",
      "!dist/*"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "5.3.0"
  },
  "allowScripts": {
    "electron@41.1.0": true
  },
  "overrides": {
    "extract-zip": {
      "yauzl": "3.4.0"
    }
  }
}
